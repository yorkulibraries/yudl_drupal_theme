<?php

/**
 * @file
 * Functions to support theming in the SASS Starterkit subtheme.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_views_pre_render().
 */
function york_drupal_theme_views_pre_render(ViewExecutable $view) {
  // Only target the Solr search view/page display.
  if ($view->id() === 'solr_search_content' && $view->current_display === 'page_1') {
    foreach ($view->header as $plugin) {
      // Check plugin ID properly.
      if ($plugin->getPluginId() === 'result') {
        $total = $view->total_rows;
        $start = $view->pager ? $view->pager->getCurrentPage() * $view->pager->getItemsPerPage() + 1 : 1;
        $end = $view->pager ? min($start + $view->pager->getItemsPerPage() - 1, $total) : $total;

        // Replace header content with formatted numbers.
        $plugin->options['content'] = t('Displaying results @start - @end of @total', [
          '@start' => number_format($start),
          '@end'   => number_format($end),
          '@total' => number_format($total),
        ]);
      }
    }
  }
}

/**
 * Implements hook_form_system_theme_settings_alter() for settings form.
 *
 * Replace Barrio setting options with subtheme ones.
 *
 * Example on how to alter theme settings form
 */
function york_drupal_theme_form_system_theme_settings_alter(&$form, FormStateInterface $form_state) {
  $form['components']['navbar']['bootstrap_barrio_navbar_top_background']['#options'] = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];
  $form['components']['navbar']['bootstrap_barrio_navbar_background']['#options'] = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];
}

/**
  * Implements hook_form_FORM_ID_alter().
  * function york_drupal_theme_form_views_exposed_form_alter(&$form, &$form_state) {
  * Targeted Form: views-exposed-form-solr-search-content-page-1
  */

function york_drupal_theme_form_views_exposed_form_alter(&$form, FormStateInterface $form_state, $form_id) {

  if ($form['#id'] == 'views-exposed-form-solr-search-content-page-1') {

    if (isset($form['search_api_fulltext']) && $form['search_api_fulltext']['#type'] == 'textfield') {
      $form['search_api_fulltext'] = array(
        '#type' => 'textfield',
        // This is the placeholder, the text inside the textfield.
        '#attributes' => array(
          'placeholder' => t('Search York University Digital Library')
          // 'class' => array('form-control form-control-lg rounded-0 ')
        ),
      );
      $form['actions']['submit']['#attributes']['class'][] = 'btn-primary';
    }
  }

  if ($form['#id'] == 'views-exposed-form-collection-search-block-1') {
    if (isset($form['collection_search']) && is_array($form['collection_search'])) {
      $placeholder = t('Search this collection');
      $short = t('Search');
      $node = \Drupal::routeMatch()->getParameter('node');
      if ($node instanceof NodeInterface && function_exists('yudl_blocks_collection_summary')) {
        $members = yudl_blocks_collection_summary($node->id())['members'];
        if ($members) {
          $placeholder = \Drupal::translation()->formatPlural($members, 'Search 1 item in this collection', 'Search @n items in this collection', ['@n' => number_format($members)]);
          $short = \Drupal::translation()->formatPlural($members, 'Search 1 item', 'Search @n items', ['@n' => number_format($members)]);
        }
        $form['#cache']['tags'][] = 'search_api_list:default_solr_index';
      }
      $form['collection_search']['#attributes']['placeholder'] = $placeholder;
      // collection.js uses this on phones, where the full text gets cut off.
      $form['collection_search']['#attributes']['data-short-placeholder'] = $short;
      $form['collection_search']['#placeholder'] = $placeholder;
      $form['collection_search']['#attributes']['class'][] = 'form-control';
      $form['collection_search']['#attributes']['class'][] = 'form-control-lg';
      $form['collection_search']['#attributes']['class'][] = 'rounded-0';
      $form['collection_search']['#attributes']['data-cs-alter'] = '1';
      $form['#attached']['library'][] = 'york_drupal_theme/collection-search-placeholder';
    }
    if (isset($form['actions']['submit']['#attributes']['class'])) {
      $form['actions']['submit']['#attributes']['class'][] = 'btn-primary';
    }
  }
}

/**
 * Implements hook_preprocess_menu().
 *
 * Several bootstrap_barrio menu templates (menu--account.html.twig,
 * menu--footer.html.twig, menu--main.html.twig, etc.) pass
 * $variables['items'] straight into a 'bootstrap_barrio:menu_*' Single
 * Directory Component (menu_columns, menu_main, ...), e.g.:
 *
 *   {{ include('bootstrap_barrio:menu_columns', {
 *       items: items
 *     })
 *   }}
 *
 * Drupal's menu items array is keyed by menu-link plugin ID
 * (e.g. 'user.logout'), not sequential integers. When PHP json_encode()'s
 * an array with non-sequential/string keys, it produces a JSON object
 * ({...}) rather than a JSON array ([...]). Each menu_* component's
 * schema declares 'items' as type: array, so SDC's validator rejects it
 * with, e.g.:
 *
 *   InvalidComponentException: "[bootstrap_barrio:menu_main/items]
 *   Object value found, but an array is required."
 *
 * This isn't limited to any one menu: Drupal filters menu links by
 * access before theming, so ANY menu can end up with non-sequential
 * keys for a user who can't see every link (most visibly anonymous
 * users). That's why this passed for an admin viewing the full menu
 * but failed for anonymous visitors on the main menu.
 *
 * Fix: recursively reindex 'items' (and each item's nested 'below'
 * children) with array_values() so every level serializes as a JSON
 * array, for every menu, regardless of who's viewing it.
 */
function york_drupal_theme_preprocess_menu(&$variables) {
  $variables['items'] = _york_drupal_theme_reindex_menu_items($variables['items']);
}

/**
 * Recursively reindexes a menu items array and its nested 'below' items.
 *
 * @param array $items
 *   A menu items array as built by Drupal for theming (menu_name-keyed
 *   at the top, each item optionally containing a 'below' array of the
 *   same shape).
 *
 * @return array
 *   The same items, sequentially reindexed at every level.
 */
function _york_drupal_theme_reindex_menu_items(array $items) {
  $items = array_values($items);
  foreach ($items as &$item) {
    if (!empty($item['below']) && is_array($item['below'])) {
      $item['below'] = _york_drupal_theme_reindex_menu_items($item['below']);
    }
  }
  return $items;
}

/**
 * Implements hook_form_alter().
 */
function york_drupal_theme_form_alter(&$form, FormStateInterface $form_state, $form_id) {

  if (strpos($form_id, 'contact_message_') !== 0 || $form_state->isSubmitted()) {
    return;
  }

  $query = \Drupal::request()->query;
  $subject = trim((string) $query->get('subject', ''));
  $category = trim((string) $query->get('category', ''));
  $message = trim((string) $query->get('message', ''));

  if ($subject === '' && $category === '' && $message === '') {
    return;
  }

  if ($subject !== '') {
    york_drupal_theme_prefill_contact_element($form, 'subject', york_drupal_theme_truncate_contact_subject($subject));
  }
  if ($message !== '') {
    york_drupal_theme_prefill_contact_element($form, 'message', $message);
  }
  if ($category !== '') {
    york_drupal_theme_prefill_contact_element($form, 'category', $category);
  }
}

/**
 * Limits generated contact subjects to the agreed 150-character maximum.
 */
function york_drupal_theme_truncate_contact_subject($subject) {
  if (mb_strlen($subject) <= 150) {
    return $subject;
  }

  return rtrim(mb_substr($subject, 0, 147)) . '...';
}

/**
 * Prefills a contact form element by machine name, title, or matching option.
 */
function york_drupal_theme_prefill_contact_element(array &$element, $field_hint, $value) {
  foreach ($element as $key => &$child) {
    if (!is_array($child) || (is_string($key) && strpos($key, '#') === 0)) {
      continue;
    }

    $key_text = strtolower((string) $key);
    $title_text = isset($child['#title']) ? strtolower((string) $child['#title']) : '';
    $matches_field = strpos($key_text, $field_hint) !== FALSE || $title_text === $field_hint;

    if ($matches_field) {
      if (isset($child['#options']) && is_array($child['#options'])) {
        foreach ($child['#options'] as $option_key => $option_label) {
          if ((string) $option_key === $value || (string) $option_label === $value) {
            $child['#default_value'] = $option_key;
            break;
          }
        }
      }
      else {
        $child['#default_value'] = $value;
      }
    }

    york_drupal_theme_prefill_contact_element($child, $field_hint, $value);
  }
}

/**
 * Implements hook_preprocess_field().
 */
function york_drupal_theme_preprocess_field(&$variables) {
  $base_path = \Drupal::request()->getSchemeAndHttpHost();
  if ($variables['element']['#field_name'] == 'field_rights') {
    foreach ($variables['element']['#items'] as $key => $items) {
      $entity = $items->entity;
      if (!empty($entity)) {
        $image_url = $entity->get('field_image_url_')->uri;
        $alt_text = isset($variables['element'][$key]['#title']) ? $variables['element'][$key]['#title'] : '';
        $term_path = $entity->get('path')->alias;
        $image = '<p><a href="' . $base_path . $term_path . '"><img class="p-1 bg-black copy_right" src="' . $image_url . '" alt="' . $alt_text . '" /></a></p>';
        $variables['items'][$key]['content'] = ['#markup' => $image];
      }
    }
  }

  $view_mode = $variables['element']['#view_mode'] ?? NULL;
  if ($view_mode !== 'oembed') {
    return;
  }

  $field_name = $variables['element']['#field_name'] ?? '';
  $is_download = is_string($field_name) && stripos($field_name, 'download') !== FALSE;
  if ($is_download) {
    $variables['attributes']->addClass('oembed-download');
    foreach ($variables['items'] as &$item) {
      if (isset($item['content']['#type']) && $item['content']['#type'] === 'link') {
        $item['content']['#options']['attributes']['class'] = $item['content']['#options']['attributes']['class'] ?? [];
        $item['content']['#options']['attributes']['class'][] = 'btn';
        $item['content']['#options']['attributes']['class'][] = 'btn-primary';
      }
      elseif (isset($item['content']['#attributes']) && is_array($item['content']['#attributes'])) {
        $item['content']['#attributes']['class'] = $item['content']['#attributes']['class'] ?? [];
        $item['content']['#attributes']['class'][] = 'btn';
        $item['content']['#attributes']['class'][] = 'btn-primary';
      }
    }
  }
}

/**
 * Implements hook_preprocess_taxonomy_term().
 */

function york_drupal_theme_preprocess_taxonomy_term(&$variables) {

  $term = $variables['term'];
  $taxonomy_term = $variables["elements"]["#taxonomy_term"];
  if ($term->hasField('field_image_url_')){
    $alt_text = $taxonomy_term->hasField('name') ? $taxonomy_term->get('name')->value : "";
    $image_url = $term->get('field_image_url_')->uri;
    $image = '<img class="p-1 bg-black copy_right" src="' . $image_url . '" alt="'. $alt_text.'">';
    $variables['content'][0] = ['#markup' => $image];
  }
}

/**
 * Implements hook_preprocess_node().
 */
function york_drupal_theme_preprocess_node(&$variables) {
  if (!empty($variables['view_mode']) && $variables['view_mode'] === 'oembed') {
    $variables['#attached']['library'][] = 'york_drupal_theme/oembed';
  }

  if (!empty($variables['view_mode']) && $variables['view_mode'] === 'collection') {
    york_drupal_theme_build_collection_header($variables);
  }

  if (!empty($variables['view_mode']) && $variables['view_mode'] === 'collection_search') {
    $variables['is_collection'] = york_drupal_theme_is_collection_node($variables['node']);
  }

  york_drupal_theme_build_paged_viewer($variables);
  york_drupal_theme_build_item_summary($variables);
}

/**
 * Puts the paged content viewer at the top of a book or issue's own display.
 *
 * Books and publication issues are shown in OpenSeadragon from their IIIF
 * book manifest. This used to be a block placed above the node by the
 * openseadragon_block context, which put the node's header ("Submitted by")
 * under the viewer; inside the node it sits where single objects have theirs.
 */
function york_drupal_theme_build_paged_viewer(array &$variables) {
  $node = $variables['node'];
  if (empty($variables['page']) || !$node instanceof NodeInterface || !$node->hasField('field_model') || $node->get('field_model')->isEmpty()) {
    return;
  }
  $model = $node->get('field_model')->entity;
  if (!$model || !$model->hasField('field_external_uri') || $model->get('field_external_uri')->isEmpty()) {
    return;
  }
  $paged_models = ['https://schema.org/Book', 'https://schema.org/PublicationIssue'];
  if (!in_array($model->get('field_external_uri')->first()->getUrl()->getUri(), $paged_models, TRUE)) {
    return;
  }

  $block = \Drupal::service('plugin.manager.block')->createInstance('openseadragon_block', [
    'iiif_manifest_url' => '/node/[node:nid]/book-manifest',
  ]);
  $variables['content']['paged_viewer'] = $block->build() + ['#weight' => -100];
}

/**
 * Returns TRUE when a node is a collection (same test as the Collection context).
 */
function york_drupal_theme_is_collection_node($node) {
  if (!$node instanceof NodeInterface || !$node->hasField('field_model') || $node->get('field_model')->isEmpty()) {
    return FALSE;
  }
  $model = $node->get('field_model')->entity;
  if (!$model) {
    return FALSE;
  }
  if ($model->hasField('field_external_uri') && !$model->get('field_external_uri')->isEmpty()) {
    return $model->get('field_external_uri')->first()->getUrl()->getUri() === 'http://purl.org/dc/dcmitype/Collection';
  }
  return $model->label() === 'Collection';
}

/**
 * Returns the collection node for the current page, if it is one.
 */
function york_drupal_theme_current_collection() {
  if (\Drupal::routeMatch()->getRouteName() !== 'entity.node.canonical') {
    return NULL;
  }
  $node = \Drupal::routeMatch()->getParameter('node');
  return york_drupal_theme_is_collection_node($node) ? $node : NULL;
}

/**
 * Lays out the collection view mode beside the collection image.
 *
 * The description, the created/updated badges and the notes go in one
 * column next to the image. The permalink and relation (finding aid) move
 * to buttons beside the page title (york_drupal_theme_preprocess_page_title()),
 * and the "Submitted by" line is hidden.
 */
function york_drupal_theme_build_collection_header(array &$variables) {
  $node = $variables['node'];
  $content = &$variables['content'];
  $variables['display_submitted'] = FALSE;
  $variables['#attached']['library'][] = 'york_drupal_theme/collection';

  $body = [
    '#type' => 'container',
    '#attributes' => ['class' => ['collection-header-body']],
    '#weight' => 1,
  ];

  if (!empty($content['field_description'][0])) {
    $body['description'] = $content['field_description'];
    $body['description']['#weight'] = 0;
  }

  if (function_exists('yudl_blocks_collection_summary') && function_exists('yudl_blocks_format_time')) {
    $summary = yudl_blocks_collection_summary($node->id());
    $badges = [];
    if ($summary['first_added']) {
      $badges[] = ['icon' => 'created', 'label' => t('Created'), 'value' => yudl_blocks_format_time($summary['first_added'])];
    }
    if ($summary['last_added']) {
      $badges[] = ['icon' => 'updated', 'label' => t('Updated'), 'value' => yudl_blocks_format_time($summary['last_added'])];
    }
    if ($badges) {
      $body['badges'] = [
        '#type' => 'inline_template',
        '#template' => '<ul class="collection-badges">{% for badge in badges %}<li><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">{% if badge.icon == "created" %}<path d="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7zm12 8v10H5V10h14z"/>{% else %}<path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 10.4 3.2 3.2-1.4 1.4L11 13.2V6h2v6.4z"/>{% endif %}</svg><span>{{ badge.label }} <strong>{{ badge.value }}</strong></span></li>{% endfor %}</ul>',
        '#context' => ['badges' => $badges],
        '#cache' => ['tags' => ['search_api_list:default_solr_index']],
        '#weight' => 1,
      ];
    }
  }

  if (!empty($content['field_note'][0])) {
    $note = $content['field_note'];
    $note['#label_display'] = 'hidden';
    $body['note'] = [
      '#type' => 'container',
      '#attributes' => ['class' => ['collection-note'], 'role' => 'note'],
      '#weight' => 2,
      'field' => $note,
    ];
  }

  unset($content['field_description'], $content['field_note'], $content['field_hdl'], $content['field_relation']);
  $content['collection_header_body'] = $body;
}

/**
 * Implements hook_preprocess_HOOK() for page_title.
 *
 * Puts the finding aid (field_relation) and permalink (field_hdl) buttons
 * beside the title on collection pages.
 */
function york_drupal_theme_preprocess_page_title(&$variables) {
  $node = york_drupal_theme_current_collection();
  if (!$node) {
    return;
  }

  $relation = '';
  if ($node->hasField('field_relation') && !$node->get('field_relation')->isEmpty()) {
    $value = trim((string) $node->get('field_relation')->value);
    if (preg_match('#^https?://#i', $value)) {
      $relation = $value;
    }
  }
  $hdl = ($node->hasField('field_hdl') && !$node->get('field_hdl')->isEmpty()) ? $node->get('field_hdl')->value : '';
  if (!$relation && !$hdl) {
    return;
  }

  $variables['title_suffix']['collection_actions'] = [
    '#type' => 'inline_template',
    '#template' => '<div class="collection-actions">{% if relation %}<a class="collection-btn" href="{{ relation }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 3v2h3.6l-9.8 9.8 1.4 1.4L19 6.4V10h2V3h-7zM5 5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-6h-2v6H5V7h6V5H5z"/></svg>{{ "Finding aid"|t }}</a>{% endif %}{% if hdl %}<button type="button" class="collection-btn" data-copy="{{ hdl }}" title="{{ hdl }}" aria-label="{{ "Copy permalink"|t }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z"/></svg><span>{{ "Permalink"|t }}</span></button>{% endif %}</div>',
    '#context' => ['relation' => $relation, 'hdl' => $hdl],
    '#attached' => ['library' => ['york_drupal_theme/collection']],
    '#cache' => ['tags' => $node->getCacheTags(), 'contexts' => ['route']],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for block.
 */
function york_drupal_theme_preprocess_block(&$variables) {
  if (($variables['plugin_id'] ?? '') === 'page_title_block') {
    $variables['#cache']['contexts'][] = 'route';
    if (york_drupal_theme_current_collection()) {
      $variables['attributes']['class'][] = 'collection-title-row';
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for views_view.
 */
function york_drupal_theme_preprocess_views_view(&$variables) {
  if ($variables['view']->id() === 'collection_search') {
    $variables['#attached']['library'][] = 'york_drupal_theme/collection';
  }
}

/**
 * Groups an object's description, permalink and share/embed actions.
 *
 * On islandora_object displays that include AddToAny (the full object page
 * view modes), field_description, field_hdl and addtoany are replaced by a
 * single 'item_summary' element at the position of the first of them:
 * the description, then an action bar with the permalink (plus a copy
 * button) on the left and the share/embed buttons on the right.
 */
function york_drupal_theme_build_item_summary(array &$variables) {
  $node = $variables['node'];
  $content = &$variables['content'];
  if (!$node instanceof NodeInterface || $node->bundle() !== 'islandora_object' || empty($content['addtoany'])) {
    return;
  }

  $keys = ['field_description', 'field_hdl', 'addtoany'];
  $weights = [];
  foreach ($keys as $key) {
    if (isset($content[$key]['#weight'])) {
      $weights[] = $content[$key]['#weight'];
    }
  }

  $summary = [
    '#type' => 'container',
    '#attributes' => ['class' => ['item-summary']],
    '#weight' => $weights ? min($weights) : 0,
    '#attached' => ['library' => ['york_drupal_theme/item_summary']],
  ];

  if (!empty($content['field_description'][0])) {
    $summary['description'] = [
      '#type' => 'container',
      '#attributes' => ['class' => ['item-description']],
      'field' => $content['field_description'],
    ];
  }

  $summary['actions'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['item-actions']],
  ];

  // field_hdl is only top level when it isn't placed in a field group.
  if (!empty($content['field_hdl'][0]) && !$node->get('field_hdl')->isEmpty()) {
    $summary['actions']['permalink'] = [
      '#type' => 'inline_template',
      '#template' => '<div class="item-permalink"><span class="item-permalink__label">{{ "Permalink"|t }}</span><a href="{{ url }}" property="dcterms:hdl" target="_blank" rel="noopener">{{ url }}</a><button type="button" class="item-copy" data-copy="{{ url }}" title="{{ "Copy permalink"|t }}" aria-label="{{ "Copy permalink"|t }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z"/></svg></button></div>',
      '#context' => ['url' => $node->get('field_hdl')->value],
    ];
  }

  $summary['actions']['share'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['item-share']],
    'label' => [
      '#type' => 'html_tag',
      '#tag' => 'span',
      '#value' => t('Share'),
      '#attributes' => ['class' => ['item-share__label']],
    ],
    'addtoany' => $content['addtoany'],
  ];

  foreach ($keys as $key) {
    unset($content[$key]);
  }
  $content['item_summary'] = $summary;
}

/**
 * Returns TRUE when the embed button should be shown for a node.
 */
function york_drupal_theme_should_show_embed_button(NodeInterface $node) {
  if (!$node->hasField('field_model') || $node->get('field_model')->isEmpty()) {
    return FALSE;
  }

  $model_term = $node->get('field_model')->entity;
  if (!$model_term) {
    return FALSE;
  }

  $model_uri = '';
  if ($model_term->hasField('field_external_uri') && !$model_term->get('field_external_uri')->isEmpty()) {
    $model_uri = $model_term->get('field_external_uri')->first()->getUrl()->getUri();
  }

  $allowed_model_uris = [
    'http://purl.org/dc/dcmitype/Sound',
    'http://purl.org/dc/dcmitype/MovingImage',
    'http://purl.org/dc/dcmitype/StillImage',
    'https://schema.org/AudioObject',
    'https://schema.org/VideoObject',
    'https://schema.org/ImageObject',
  ];

  if ($model_uri !== '' && in_array($model_uri, $allowed_model_uris, TRUE)) {
    return TRUE;
  }

  $label = $model_term->label();
  if (!is_string($label) || $label === '') {
    return FALSE;
  }

  $allowed_label_fragments = [
    'audio',
    'video',
    'image',
    'still image',
    'moving image',
    'sound',
  ];
  foreach ($allowed_label_fragments as $fragment) {
    if (stripos($label, $fragment) !== FALSE) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Returns TRUE when the current request is Drupal's 404 page.
 */
function york_drupal_theme_is_404_page() {
  return \Drupal::routeMatch()->getRouteName() === 'system.404';
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function york_drupal_theme_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name === 'yudl_oembed.embed') {
    $suggestions[] = 'page__oembed';
  }

  if (york_drupal_theme_is_404_page()) {
    $suggestions[] = 'page__404';
  }
}

/**
 * Implements hook_preprocess_page().
 */
function york_drupal_theme_preprocess_page(&$variables) {
  $variables['is_404_page'] = york_drupal_theme_is_404_page();
  if ($variables['is_404_page']) {
    $variables['cat_item_url'] = 'https://digital.library.yorku.ca/cat-persian-cat-owned-harry-shearer-copy-toronto-telegram-fonds/cat-persian-cat-owned-harry-shearer';
    $variables['cat_credit_url'] = 'https://digital.library.yorku.ca/clara-thomas-archives-special-collections/toronto-telegram-fonds';
    $variables['cat_title'] = 'Cat : Persian Cat Owned by Harry Shearer [copy]';
    $variables['cat_description'] = "Image of a picture on a cork board of a cat with a blanket over its head. The words 'What's It Like Out?' are written on the left-hand side.";
    $variables['cat_date'] = 'October 2, 1957';
  }

  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name !== 'entity.node.canonical') {
    return;
  }

  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node instanceof NodeInterface) {
    return;
  }

  if (!york_drupal_theme_should_show_embed_button($node)) {
    return;
  }

  $variables['#attached']['library'][] = 'york_drupal_theme/embed_button';
}

/**
 * Preprocess function for Views unformatted summary rows.
 *
 * This function formats numeric counts in A–Z or similar unformatted
 * summary Views (like a glossary or taxonomy summary) by adding
 * comma separators for thousands.
 *
 * Example:
 *   N (19244) -> N (19,244)
 *
 * @param array $vars
 *   An associative array of variables passed to the template, containing:
 *   - rows: An array of Views result objects, each potentially containing a 'count' property.
 */
function york_drupal_theme_preprocess_views_view_summary_unformatted(array &$vars) {
  foreach ($vars['rows'] as $row) {
    if (isset($row->count)) {
      $row->count = number_format($row->count);
    }
  }
}

/**
 * Preprocess function for Facets result items.
 *
 * This function formats numeric counts for Facet items by adding
 * comma separators for thousands, e.g.:
 *   Toronto Telegram fonds (18267)  -> Toronto Telegram fonds (18,267)
 *
 * @param array $vars
 *   An associative array of variables passed to the template, containing:
 *   - count: The numeric count of items for this facet.
 */
function york_drupal_theme_preprocess_facets_result_item(array &$vars) {
  if (isset($vars['count']) && is_numeric($vars['count'])) {
    $vars['count'] = number_format((int) $vars['count']);
  }
}
